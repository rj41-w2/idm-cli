{
  "manifest_version": 3,
  "name": "IDM-CLI Downloader",
  "version": "1.1.6",
  "description": "Download files and videos directly to IDM-CLI",
  "permissions": ["contextMenus", "nativeMessaging", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
